# Reference only: export in the shell; Steward does not auto-load this file.
STEWARD_EXECUTION_MODE=dry_run
STEWARD_DATABASE_PATH=steward.db
STEWARD_AWS_REGION=us-east-1
STEWARD_BEDROCK_MODEL_ID=amazon.nova-pro-v1:0
STEWARD_QUOTE_MAX_TOKENS=1024
STEWARD_AUTO_QUEUE_RFQ_CATEGORIES=elevator
STEWARD_SIMULATION=true
STEWARD_SIMULATION_CLOCK_START=2026-09-09T10:00:00+00:00
STEWARD_API_TOKENS={"local-review-only":{"actor_id":"Simon O.","role":"manager"}}
# Optional: STEWARD_DATABASE_URL / STEWARD_DATABASE_SECRET, STEWARD_AWS_PROFILE.
# Live credentials belong in Secrets Manager, never in source control.

# Optional private Telegram account linking and local TEST-bot polling.
# Never run polling and a webhook on the same bot simultaneously.
STEWARD_TELEGRAM_TEST_POLLING=false
# Independent of mail/supplier execution. Use live only for an authorized connected bot.
STEWARD_TELEGRAM_DELIVERY_MODE=dry_run
# STEWARD_TELEGRAM_BOT_USERNAME=your_test_bot
# STEWARD_TELEGRAM_BOT_TOKEN, STEWARD_TELEGRAM_WEBHOOK_SECRET and
# STEWARD_TELEGRAM_ALLOWED_CHAT_IDS must be provided through protected configuration.
